# What the public EURAG endpoint needs that must outlive the cluster.
# `make down` destroys AKS; everything here stays, so `make up` brings the
# site back on the same address with the same secrets and corpus.

# Static IP for the gateway. It lives here, not in the AKS node resource
# group, so the DNS record set once keeps pointing at the gateway after
# every rebuild. The AKS stack grants the cluster permission to use it.
resource "azurerm_public_ip" "ingress" {
  name                = "pip-${local.name}-ingress"
  location            = var.location
  resource_group_name = azurerm_resource_group.core.name
  allocation_method   = "Static"
  sku                 = "Standard"
  tags                = local.tags
}

# Corpus cache for EURAG. EUR-Lex refuses requests from cloud IPs, so the
# seed in the cluster restores the cache from here instead of scraping.
# Entra ID only: shared keys and anonymous access are off.
resource "azurerm_storage_account" "data" {
  name                            = "st${local.unique}"
  location                        = var.location
  resource_group_name             = azurerm_resource_group.core.name
  account_tier                    = "Standard"
  account_replication_type        = "LRS"
  min_tls_version                 = "TLS1_2"
  shared_access_key_enabled       = false
  default_to_oauth_authentication = true
  allow_nested_items_to_be_public = false
  tags                            = local.tags
}

resource "azurerm_storage_container" "corpus" {
  name                  = "corpus"
  storage_account_id    = azurerm_storage_account.data.id
  container_access_type = "private"
}

# EURAG reads the corpus; platform admins upload it.
resource "azurerm_role_assignment" "eurag_corpus_reader" {
  scope                = azurerm_storage_container.corpus.id
  role_definition_name = "Storage Blob Data Reader"
  principal_id         = azurerm_user_assigned_identity.eurag.principal_id
  principal_type       = "ServicePrincipal"
}

resource "azurerm_role_assignment" "admin_corpus_writer" {
  for_each = toset(local.platform_admins)

  scope                = azurerm_storage_container.corpus.id
  role_definition_name = "Storage Blob Data Contributor"
  principal_id         = each.value
}

# EURAG's own secrets, generated here and written straight to Key Vault.
# Nobody types or sees them; pods read them through workload identity.
# The values are in Terraform state, which sits in a storage account that
# only accepts Entra ID sign-ins.
resource "random_bytes" "eurag_key" {
  for_each = toset(["eurag-jwt-secret", "eurag-encryption-key"])

  length = 32 # EURAG expects 64 hex characters (AES-256 for the encryption key)
}

resource "random_password" "eurag" {
  for_each = toset(["eurag-postgres-password", "eurag-redis-password"])

  length  = 40
  special = false # used inside connection URLs
}

locals {
  eurag_generated_secrets = toset([
    "eurag-jwt-secret",
    "eurag-encryption-key",
    "eurag-postgres-password",
    "eurag-redis-password",
  ])
}

resource "azurerm_key_vault_secret" "eurag_generated" {
  for_each = local.eurag_generated_secrets

  name         = each.key
  key_vault_id = module.key_vault.id
  content_type = "generated by Terraform"
  value = (
    contains(keys(random_bytes.eurag_key), each.key)
    ? random_bytes.eurag_key[each.key].hex
    : random_password.eurag[each.key].result
  )
}
